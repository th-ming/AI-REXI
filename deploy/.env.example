# ═══════════════════════════════════════════════════════════════
# Rexi AI — biến môi trường deploy (copy thành .env rồi sửa)
# ═══════════════════════════════════════════════════════════════

# Domain trỏ về IP VPS (Caddy sẽ tự cấp HTTPS miễn phí)
DOMAIN=rexi.example.com

# Secret cho OpenCut auth (nên đổi thành chuỗi dài ngẫu nhiên)
OPENCUT_AUTH_SECRET=change-me-opencut-secret

# URL công khai của frontend (dùng để build redirect URI OAuth + redirect callback).
# Trên Render đặt: https://rexiai.bot.cd
FRONTEND_URL=https://rexiai.bot.cd

# ═══════════════════════════════════════════════════════════════
# SOCIAL POSTING CONNECTORS (scaffold — bỏ trống = tính năng tắt an toàn)
# /api/social/status sẽ báo configured:false khi thiếu key. Không ảnh hưởng app.
# Chi tiết cách tạo app + scope + redirect URI: docs/SOCIAL.md
# ═══════════════════════════════════════════════════════════════

# ── X (Twitter) OAuth 2.0 PKCE ─────────────────────────────────
# X_REDIRECT_URI mặc định: ${FRONTEND_URL}/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# ── TikTok (Login Kit + Content Posting API) ───────────────────
# Redirect URI mặc định: ${FRONTEND_URL}/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ── Instagram (Meta Graph API — IG Business/Creator) ───────────
# Redirect URI mặc định: ${FRONTEND_URL}/api/social/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
