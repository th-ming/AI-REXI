# ═══════════════════════════════════════════════════════════════
# AI REXI — Backend Dockerfile (VPS rác friendly, ~300MB runtime)
# Build:  docker build -f deploy/Dockerfile.backend -t ai-rexi-backend .
# ═══════════════════════════════════════════════════════════════
FROM node:20-slim

# Python3 + yt-dlp + ffmpeg cho tính năng YouTube Free / Tóm tắt AI
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg curl \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

# Cài dependencies trước (cache tốt hơn)
COPY Backend/package.json Backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Copy source
COPY Backend/ ./

# Thư mục tạm cho upload/audio/video
RUN mkdir -p temp

ENV NODE_ENV=production
ENV PORT=5000

# Database nằm ngoài container (volume) tại /app/Database
EXPOSE 5000

CMD ["node", "server.js"]
